PORT=5000
NODE_ENV=production

DATABASE_URL=postgresql://user:password@host:5432/autopilot_ai
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

SESSION_SECRET=replace_with_a_long_random_secret

# Render public URL for this Express service.
BACKEND_PUBLIC_URL=https://your-render-backend.onrender.com

# Primary frontend URL plus optional comma-separated extras.
FRONTEND_URL=https://your-vercel-frontend.vercel.app
FRONTEND_URLS=https://your-vercel-frontend.vercel.app

# Optional: allow Vercel preview deployments to call the API.
ALLOW_VERCEL_PREVIEWS=false

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://your-render-backend.onrender.com/api/auth/google/callback

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=https://your-render-backend.onrender.com/api/auth/github/callback
